rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(discordId) {
      return isAuthenticated() && request.auth.uid == discordId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role in ['owner', 'management', 'senior_admin', 'admin']
      );
    }

    // --- Collection Rules ---

    // USERS Collection (Document ID is canonical Discord ID)
    match /users/{discordId} {
      allow get: if isOwner(discordId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(discordId) && request.resource.data.role == 'user';
      allow update: if isOwner(discordId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions']));
      allow write: if isAdmin();
    }

    // GALLERY Collection
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // STAFF Collection
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CONFIG Collection
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# ==============================================================================
# Vital RP — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# --- Discord OAuth 2.0 (Server-Side Only) ---
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_GUILD_ID=your_vital_rp_discord_guild_id_here
# Optional: Bot token to query server member roles if the user token lacks permissions
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# --- Session & Security ---
# Generate a random 32+ character string for HMAC session signing
SESSION_SECRET=your_secure_random_session_secret_at_least_32_chars_long

# --- Firebase Admin SDK (Server-Side Only) ---
FIREBASE_PROJECT_ID=vitalrpnet
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vitalrpnet.iam.gserviceaccount.com
# Note: In production or .env, enclose private key in quotes and keep \n as literal \n or escaped newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"

# --- Firebase Client SDK (Public Browser Variables) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_public_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vitalrpnet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vitalrpnet
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vitalrpnet.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=497680378833
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-2E3FDW1LJW

# --- FiveManage Media API (Server-Side Only - NEVER expose with NEXT_PUBLIC_) ---
FIVEMANAGE_API_KEY=your_private_fivemanage_api_key_here

# --- FiveM / CFX Configuration ---
CFX_SERVER_ID=ogpvmv
NEXT_PUBLIC_CFX_SERVER_ID=ogpvmv
